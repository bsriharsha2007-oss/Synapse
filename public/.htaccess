RewriteEngine On

# Allow login page and static assets (CSS/JS/images) to load directly
RewriteCond %{REQUEST_URI} ^/login\.html$ [NC,OR]
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|ico|svg)$ [NC]
RewriteRule ^ - [L]

# Route everything else (/, /index.html, /admin.html, /api/*) through router.php
RewriteRule ^ router.php [QSA,L]