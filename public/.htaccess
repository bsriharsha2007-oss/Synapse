RewriteEngine On

# Serve the sign-in page and static assets directly.
RewriteRule ^login\.html$ - [L,NC]
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|svg|ico)$ [NC]
RewriteRule ^ - [L]

# Route the home page, other HTML pages, and API requests through the application router.
RewriteRule ^ router.php [QSA,L]